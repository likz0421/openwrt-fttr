#!/bin/sh /etc/rc.common
START=80
STOP=20

USE_PROCD=1
PROG=/usr/sbin/fttrd

# Board identity may be published by board.d slightly after init starts.
# Wait briefly so a fast-start race cannot make platform-check fail closed.
platform_ready() {
	i=0
	while [ "$i" -lt 15 ]; do
		if "$PROG" --platform-check >/dev/null 2>&1; then
			return 0
		fi
		i=$((i + 1))
		sleep 1
	done
	return 1
}

start_service() {
	# Let fttrd's exact platform registry fail closed before touching hardware,
	# but never hide WHY. Wait for board identity, then log the platform report.
	if ! platform_ready; then
		logger -t fttr "platform-check failed; fttrd NOT started. board=$(cat /tmp/sysinfo/board_name 2>/dev/null) compat=$(tr '\0' ' ' </proc/device-tree/compatible 2>/dev/null) report=$("$PROG" --platform-info 2>&1)"
		return 0
	fi

	echo "[*] Initializing FTTR Micro-OLT Subsystem..."

	# Start the controller daemon.
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 5
	procd_close_instance
}

stop_service() {
	echo "[*] Stopping FTTR Subsystem..."
	nft delete table bridge fttr_mqtt_redirect 2>/dev/null || true
	nft delete table ip fttr_mqtt_redirect 2>/dev/null || true
	if "$PROG" --platform-check >/dev/null 2>&1; then
		/usr/sbin/fttrctl optical shutdown --json || logger -t fttr "Owner shutdown failed; checking reset after termination"
	fi
}

service_stopped() {
	# procd deletion is asynchronous. The CLI waits boundedly for ownership;
	# it never writes hardware while a daemon still owns it.
	nft delete table bridge fttr_mqtt_redirect 2>/dev/null || true
	nft delete table ip fttr_mqtt_redirect 2>/dev/null || true
	if "$PROG" --platform-check >/dev/null 2>&1; then
		/usr/sbin/fttrctl optical shutdown-offline --json || logger -t fttr "Optical reset not confirmed after stop"
	fi
}

service_triggers() {
	procd_add_reload_trigger fttr
	# Run restart outside fttrd's cgroup so stopping fttrd cannot kill it.
	procd_add_raw_trigger "fttr.restart" 1000 /etc/init.d/fttr restart
}

reload_service() {
	/usr/sbin/fttrctl optical reload --json || return $?
	/usr/sbin/fttrctl config reload
}
